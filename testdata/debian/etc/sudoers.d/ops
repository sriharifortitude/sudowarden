# Rules added over time for the operations team.
Cmnd_Alias WEB = /usr/bin/systemctl restart nginx, /usr/bin/systemctl reload nginx
Cmnd_Alias LOGS = /usr/bin/less /var/log/nginx/*, /usr/bin/journalctl -u nginx

deploy  ALL=(root) NOPASSWD: WEB, LOGS
deploy  ALL=(www-data) NOPASSWD: /usr/bin/git -C /srv/app pull
backup  ALL=(root) NOPASSWD: /usr/bin/tar -czf /backup/etc.tgz /etc, /usr/bin/rsync
monitor ALL=(root) NOPASSWD: /home/monitor/bin/check_disk
helpdesk ALL=(ALL) ALL, !/usr/bin/su, !/bin/bash
Defaults:deploy env_keep += "PYTHONPATH"
